rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Authorized admin verification (tharshini1773@gmail.com)
    function isSingleAdmin() {
      return request.auth != null && 
             request.auth.token.email != null && 
             (request.auth.token.email.lower() == 'tharshini1773@gmail.com' || 
              request.auth.token.email.lower() == 'tharshnitharshni28@gmail.com');
    }

    match /certificates/{allPaths=**} {
      // Public visitors can view and download certificate files
      allow read: if true;
      // Only the authorized admin can upload, update, or delete certificate files
      allow write: if isSingleAdmin();
    }
  }
}
